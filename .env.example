# EduConnect — variáveis de ambiente (exemplo).
# Copie para .env e preencha com valores próprios. NUNCA versione o .env real.

# ---------- Banco de dados (PostgreSQL) ----------
DB_URL=jdbc:postgresql://localhost:5432/educonnect
DB_USERNAME=educonnect
DB_PASSWORD=defina-uma-senha-forte

# ---------- Segurança ----------
# Segredo para assinar os tokens JWT: no mínimo 32 caracteres aleatórios.
# Gere com: openssl rand -base64 48
JWT_SECRET=substitua-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRATION_MINUTES=120

# Origens autorizadas a chamar a API (separadas por vírgula).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Primeiro administrador ----------
# Usado apenas quando o banco não possui nenhum usuário. Depois, pode ser removido.
# Senha: 8+ caracteres com letras e números.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_NOME=Administrador

# ---------- Dados de demonstração (opcional, apenas desenvolvimento) ----------
# Ative iniciando o backend com o perfil "demo" (veja o README). Os registros aparecem como "[Exemplo]".
# Senha das contas de exemplo (8+ caracteres).
DEMO_PASSWORD=

# ---------- Servidor ----------
SERVER_PORT=8080
